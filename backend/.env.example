# ==============================================================================
# PatchPilot Backend - Environment Variables
# Copy to .env: cp .env.example .env
# ==============================================================================

ENVIRONMENT=development
LOG_LEVEL=info

# FastAPI Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_USER=patchpilot
POSTGRES_PASSWORD=patchpilot_dev_password
POSTGRES_DB=patchpilot_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://patchpilot:patchpilot_dev_password@localhost:5432/patchpilot_db
# Sync database URL for Alembic migrations
SYNC_DATABASE_URL=postgresql://patchpilot:patchpilot_dev_password@localhost:5432/patchpilot_db

# Future Agent & Integration Placeholders (Not currently active)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GITHUB_TOKEN=
