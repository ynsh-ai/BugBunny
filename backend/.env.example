# ==============================================================================
# BugBunny Backend — Environment Configuration Template
# Copy this file to .env before starting backend: cp .env.example .env
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
LOG_LEVEL=info

# --- FastAPI Server Binding ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL Configuration (Mode 1: Local / Mode 3: Docker) ---
POSTGRES_USER=bugbunny
POSTGRES_PASSWORD=bugbunny_password
POSTGRES_DB=bugbunny_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bugbunny:bugbunny_password@localhost:5432/bugbunny_db
SYNC_DATABASE_URL=postgresql://bugbunny:bugbunny_password@localhost:5432/bugbunny_db

# --- Multi-Agent Workflow & Provider Configuration ---
# AGENT_MODE: demo (safe offline heuristics, zero cost) | live (requires GEMINI_API_KEY)
AGENT_MODE=demo
AGENT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Optional alternative provider:
# AGENT_PROVIDER=openai
# OPENAI_API_KEY=

# --- Read-Only GitHub Integration ---
# Optional personal access token to raise public GitHub API rate limits (60/hr -> 5,000/hr)
# Kept strictly server-side; NEVER returned or exposed to frontend.
GITHUB_TOKEN=
