# ==============================================================================
# BugBunny Backend — Environment Configuration
# Copy this file to .env before starting backend: cp .env.example .env
# ==============================================================================

ENVIRONMENT=development
LOG_LEVEL=info

# FastAPI Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Configuration
POSTGRES_USER=bugbunny
POSTGRES_PASSWORD=bugbunny_password
POSTGRES_DB=bugbunny_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bugbunny:bugbunny_password@localhost:5432/bugbunny_db
SYNC_DATABASE_URL=postgresql://bugbunny:bugbunny_password@localhost:5432/bugbunny_db

# Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Multi-Agent Workflow & Provider Configuration (Milestone 3)
AGENT_MODE=demo
AGENT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Optional server-side GitHub Personal Access Token (Read-Only)
GITHUB_TOKEN=
