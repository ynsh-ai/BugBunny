# ==============================================================================
# BugBunny — Autonomous Multi-Agent Software Engineering Assistant
# Root Environment Configuration Template (Used by Docker Compose)
# Copy this file to .env before running docker compose: cp .env.example .env
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
LOG_LEVEL=info

# --- PostgreSQL Database (Docker Compose) ---
POSTGRES_USER=bugbunny
POSTGRES_PASSWORD=bugbunny_password
POSTGRES_DB=bugbunny_db
POSTGRES_PORT=5432

# --- Backend Configuration (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend Configuration (Next.js) ---
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Multi-Agent Workflow & Provider Configuration ---
# AGENT_MODE: demo (zero external API calls) | live (requires GEMINI_API_KEY)
AGENT_MODE=demo
AGENT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# --- Read-Only GitHub Integration ---
# Optional personal access token to raise public GitHub API rate limits
GITHUB_TOKEN=
