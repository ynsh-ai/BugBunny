# ==============================================================================
# PatchPilot AI - Environment Configuration Template
# Copy this file to .env before starting the services: cp .env.example .env
# NOTE: Never commit sensitive credentials to version control.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
LOG_LEVEL=info

# --- PostgreSQL Database (Docker & Backend) ---
POSTGRES_USER=patchpilot
POSTGRES_PASSWORD=patchpilot_dev_password
POSTGRES_DB=patchpilot_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://patchpilot:patchpilot_dev_password@localhost:5432/patchpilot_db

# --- Backend Configuration (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Frontend Configuration (Next.js) ---
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Future Agent & Model Integrations (Placeholders - Not active yet) ---
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# GITHUB_TOKEN=your_github_token_here
