# ==============================================================================
# BugBunny — Autonomous Multi-Agent Software Engineering Assistant
# Environment Configuration Template
# Copy this file to .env before starting services: cp .env.example .env
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
LOG_LEVEL=info

# --- PostgreSQL Database (Docker & Backend) ---
POSTGRES_USER=bugbunny
POSTGRES_PASSWORD=bugbunny_password
POSTGRES_DB=bugbunny_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bugbunny:bugbunny_password@localhost:5432/bugbunny_db
SYNC_DATABASE_URL=postgresql://bugbunny:bugbunny_password@localhost:5432/bugbunny_db

# --- Backend Configuration (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend Configuration (Next.js) ---
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Multi-Agent Workflow & Provider Configuration (Milestone 3) ---
# AGENT_MODE: demo (zero external API calls) | live (requires GEMINI_API_KEY)
AGENT_MODE=demo
AGENT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# --- Read-Only GitHub Integration (Milestone 3) ---
# Optional server-side personal access token to increase GitHub API rate limits.
# Kept strictly server-side; NEVER returned or exposed to frontend.
GITHUB_TOKEN=
